# Copy to repo root `.env` and fill in (repo `.env` is gitignored).
#
#   cp .env.keys.template .env
#   nano .env
#
# Then always load before server / pipeline:
#   set -a && source .env && set +a

# Gemini (preferred for book research: call_with_search uses Google Search grounding).
# google.genai also accepts GEMINI_API_KEY — set one or the other.
export GEMINI_KEY=""
# export GEMINI_API_KEY=""
export OPENAI_API_KEY=""
export ANTHROPIC_API_KEY=""

# Optional: last-resort curriculum generator if Opus API + `claude` CLI both fail (e.g. no Max login).
# Leave unset to rely on Anthropic API or `claude -p` subscription (CLI ignores ANTHROPIC_* in subprocess).
# export PETRARCA_CURRICULUM_FALLBACK_MODEL=gpt-4o-mini

# Optional: gpt-4o-mini (default), gpt-4o, etc.
# export PETRARCA_OPENAI_MODEL=gpt-4o-mini
# export PETRARCA_OPENAI_VISION_MODEL=gpt-4o-mini

# Optional: force one backend: gemini | openai
# export PETRARCA_LLM_BACKEND=openai
