# Copy to .env and adjust. Expo inlines EXPO_PUBLIC_* at bundle time — restart Metro after changes.

# API (research-server.py). Use any hostname your phone resolves (Tailscale IP, Pi-hole local name, etc.):
# EXPO_PUBLIC_RESEARCH_SERVER_URL=http://mini.lan:8090

# Optional: nginx JSON tree (native only defaults to production HTTPS).
# EXPO_PUBLIC_CONTENT_BASE_URL=https://your-host/content

# Optional: static web (guide/, map/) — native only defaults to production :8084.
# EXPO_PUBLIC_WEB_APP_ORIGIN=https://your-host:8084
