# Copy to scripts/.env.mac-mini (or ~/petrarca/.env) and adjust paths.
# Source before running the research server or pipeline:
#   set -a && source scripts/.env.mac-mini && set +a
#
# Tailscale: use your Mac's Tailscale IP or MagicDNS name, e.g.
#   http://100.x.y.z:8090  or  http://my-mac.tailnet-name.ts.net:8090
# Point the Expo app at the same host (app/.env):
#   EXPO_PUBLIC_RESEARCH_SERVER_URL=http://100.x.y.z:8090
#   EXPO_PUBLIC_CONTENT_BASE_URL=http://100.x.y.z:8090/content
#   EXPO_PUBLIC_WEB_APP_ORIGIN=http://100.x.y.z:8084
# (8083/8084 only if you run nginx or a static server for those; see below.)

# --- Data root (all Petrarca state on this machine) ---
export PETRARCA_DATA="${PETRARCA_DATA:-$HOME/petrarca-data}"
mkdir -p "$PETRARCA_DATA/logs" "$PETRARCA_DATA/research-results" "$PETRARCA_DATA/ingest" \
  "$PETRARCA_DATA/books" "$PETRARCA_DATA/chats" "$PETRARCA_DATA/notes" "$PETRARCA_DATA/audio" \
  "$PETRARCA_DATA/book-uploads" "$PETRARCA_DATA/feedback" "$PETRARCA_DATA/projects" \
  "$PETRARCA_DATA/voice_elicit_cache" "$PETRARCA_DATA/explore_capture_cache" \
  "$PETRARCA_DATA/curricula" 2>/dev/null || true

# --- limbic (optional: source checkout). Otherwise run-research-server.sh sets
# LIMBIC_ROOT from the venv's installed limbic package after pip install.
# export LIMBIC_ROOT="$HOME/src/limbic"

# --- SQLite (canonical store) ---
export PETRARCA_DB="$PETRARCA_DATA/petrarca.db"

# --- curriculum.py (defaults to /opt/petrarca/data/curricula without this) ---
export CURRICULUM_DIR="$PETRARCA_DATA/curricula"

# --- research-server.py paths (override /opt/petrarca defaults) ---
export RESEARCH_PORT=8090
export RESEARCH_RESULTS_DIR="$PETRARCA_DATA/research-results"
export INGEST_DIR="$PETRARCA_DATA/ingest"
export BOOKS_OUTPUT_DIR="$PETRARCA_DATA/books"
export CROSS_MATCH_DIR="$PETRARCA_DATA"
export CHAT_DIR="$PETRARCA_DATA/chats"
export NOTES_DIR="$PETRARCA_DATA/notes"
export AUDIO_DIR="$PETRARCA_DATA/audio"
export BOOK_UPLOADS_DIR="$PETRARCA_DATA/book-uploads"
export PHYSICAL_BOOKS_PATH="$PETRARCA_DATA/physical_books.json"
export LOG_DIR="$PETRARCA_DATA/logs"
export ARTICLES_PATH="$PETRARCA_DATA/articles.json"
export SCRAPE_REPORTS_PATH="$PETRARCA_DATA/scrape_reports.json"
export KINDLE_DATA_PATH="$PETRARCA_DATA/kindle_library.json"
export KINDLE_HIGHLIGHTS_PATH="$PETRARCA_DATA/kindle_highlights.json"
export KINDLE_SYNC_LOG_PATH="$PETRARCA_DATA/kindle_sync_log.jsonl"
export FEEDBACK_DIR="$PETRARCA_DATA/feedback"
export PROJECTS_PATH="$PETRARCA_DATA/projects.json"
export PROJECTS_MEDIA_DIR="$PETRARCA_DATA/projects"
export PHOTO_OCR_QUEUE_PATH="$PETRARCA_DATA/photo_ocr_queue.json"
export VOICE_ELICIT_CACHE_DIR="$PETRARCA_DATA/voice_elicit_cache"
export EXPLORE_CAPTURE_CACHE_DIR="$PETRARCA_DATA/explore_capture_cache"
export MEDIA_LOG_PATH="$PETRARCA_DATA/media_log.json"

# --- Pipeline JSONL audit (content-refresh.sh) ---
export PETRARCA_PIPELINE_LOG_DIR="$PETRARCA_DATA/logs"

# --- LLM (research-server, book research, pipelines) ---
# Book research uses Gemini + Google Search when GEMINI_KEY or GEMINI_API_KEY is set.
# export GEMINI_KEY=...
# Optional: stronger OpenAI model for paths that still use OpenAI (no live search there):
# export PETRARCA_OPENAI_MODEL=gpt-4o
# Optional: override model for book_research_agent only:
# export PETRARCA_BOOK_RESEARCH_MODEL=gemini-2.5-flash

# --- Optional: pipeline .env with API keys (same as server) ---
# export ANTHROPIC_API_KEY=...
# export READWISE_ACCESS_TOKEN=...
