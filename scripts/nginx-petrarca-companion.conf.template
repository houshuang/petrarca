# Private Petrarca Companion. __CAPABILITY_PATH__ is replaced at install time
# from a root/user-readable 0600 file and must never be committed. Each backend
# route is named explicitly: possession of this link does not expose Petrarca's
# broad research/admin API.
location = /__CAPABILITY_PATH__/companion {
    access_log off;
    error_log /dev/null crit;
    limit_except GET { deny all; }
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://127.0.0.1:8090/companion;
}

